# ADS-B source. Public endpoints need no key; set a descriptive contact UA.
SKYJAM_ADSB_BASE_URL=https://api.adsb.lol/v2
SKYJAM_USER_AGENT=skyjam/0.1 (HSLU MLOps student project; contact@example.com)

# Feature store: PostgreSQL on Railway, written by services/ingestor.
# Railway injects this automatically for deployed services; set it locally to
# read the history. Never commit a real value.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Ingest service tuning (see services/ingestor/README.md).
# The feed is rate-limited: 12s between discs is the measured safe spacing.
SKYJAM_INGEST_INTERVAL=30m
SKYJAM_INTER_REQUEST_DELAY=12s

# Experiment tracking / model registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=skyjam

# Optional: a throwaway PostgreSQL for the SQL integration tests. Without it
# those tests skip instead of failing.
# TEST_DATABASE_URL=postgres://postgres:test@localhost:55433/skyjam?sslmode=disable
