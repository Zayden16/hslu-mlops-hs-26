# ADS-B source. Public endpoints need no key; set a descriptive contact UA.
SKYJAM_ADSB_BASE_URL=https://api.adsb.lol/v2
SKYJAM_USER_AGENT=skyjam/0.1 (HSLU MLOps student project; contact@example.com)

# Feature store location. Local path for dev, gs:// or s3:// URI in the cloud.
SKYJAM_FEATURE_STORE_URI=data/feature_store

# Experiment tracking / model registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=skyjam

# Cloud credentials are injected via GitHub Secrets / workload identity.
# Never commit real values. Placeholders only.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCS_BUCKET=your-bucket-name
